md("""## 📊 Step 7 — Summary statistics (bonus)

**bcftools stats** generates a comprehensive summary of VCF metrics including:

- Total number of SNPs and INDELs  
- Transition/transversion ratio (Ts/Tv) — quality indicator for WGS/WES  
- Per-sample depth and genotype counts  
- INDEL length distribution  

> 💡 **Ts/Tv ratio**: for whole-exome sequencing, expected ~2.8–3.2; for whole-genome, ~2.0–2.1. Values outside this range may indicate quality issues.\
""")

code("""# Compute statistics for both callers using bcftools stats
!echo "\\n=== GATK VCF Statistics ===\\n"
!mamba run -n bcftools bcftools stats \\
  ./variants/gatk/cohort_filtered.vcf.gz | grep -E "^(SN|TSTV)" | head -20

!echo "\\n=== FreeBayes VCF Statistics ===\\n"
!mamba run -n bcftools bcftools stats \\
  ./variants/freebayes/cohort_freebayes_filtered.vcf.gz | grep -E "^(SN|TSTV)" | head -20""")

code("""# Summary comparison between callers using Python
import subprocess

def get_stats(vcf_path, label):
    result = subprocess.run(
        f"mamba run -n bcftools bcftools stats {vcf_path}",
        shell=True, capture_output=True, text=True
    )
    stats = {}
    for line in result.stdout.split("\\n"):
        if line.startswith("SN"):
            parts = line.split("\\t")
            if len(parts) >= 4:
                stats[parts[2].strip().rstrip(":")] = parts[3].strip()
    return stats

gatk_stats    = get_stats("./variants/gatk/cohort_filtered.vcf.gz", "GATK")
freebayes_stats = get_stats("./variants/freebayes/cohort_freebayes_filtered.vcf.gz", "FreeBayes")

keys = ["number of samples", "number of records", "number of SNPs", "number of indels",
        "number of multiallelic sites", "number of MNPs"]

print(f"{'Metric':<35} {'GATK':>12} {'FreeBayes':>12}")
print("-" * 60)
for k in keys:
    g = gatk_stats.get(k, "N/A")
    f = freebayes_stats.get(k, "N/A")
    print(f"{k:<35} {g:>12} {f:>12}")""")

