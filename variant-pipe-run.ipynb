md("## 🧭 Step 4 — Alignment (BWA-MEM → sorted, indexed BAM)")

md("""**BWA-MEM** aligns reads to the reference genome.  
**Samtools** converts SAM to BAM, sorts by coordinate, and creates an index for fast access.

Read groups (`-R`) are required by GATK and help track sample identity in multi-sample analyses.\
""")

code("""# Create environments for BWA and Samtools
!mamba create -n bwa -c bioconda bwa -y --quiet
!mamba create -n samtools -c bioconda samtools -y --quiet

# Index the reference genome (required before alignment)
!echo "\\n### Indexing reference genome\\n"
!mamba run -n bwa bwa index -p ./refGen/chr17_GRCh38 ./refGen/chr17_GRCh38.fasta

# Create Samtools FASTA index (required by GATK)
!mamba run -n samtools samtools faidx ./refGen/chr17_GRCh38.fasta

!mkdir -p aligned
!echo "\\n### Starting alignment\\n"

# Align + sort + index for each sample
for SAMPLE in BRCA1_WT BRCA1_185delAG BRCA1_c.5266dupC; do
  R1="./trimmed/${SAMPLE}_R1_trim.fq.gz"
  R2="./trimmed/${SAMPLE}_R2_trim.fq.gz"
  OUT="./aligned/${SAMPLE}_sorted.bam"

  echo "\\n--- Aligning ${SAMPLE} ---"
  mamba run -n bwa bwa mem -M -t 4 \\
    -R "@RG\\tID:${SAMPLE}\\tSM:${SAMPLE}\\tPL:ILLUMINA\\tLB:${SAMPLE}_lib1\\tPU:${SAMPLE}_unit1" \\
    ./refGen/chr17_GRCh38 $R1 $R2 | \\
    mamba run -n samtools samtools sort -@ 4 -o $OUT -

  mamba run -n samtools samtools index $OUT
  echo "--- Flagstat for ${SAMPLE} ---"
  mamba run -n samtools samtools flagstat $OUT
done

!echo "\\n### Aligned BAM files:"
!ls -lh ./aligned/*.bam""".replace("for SAMPLE", "!for SAMPLE").replace("done", "done"))

